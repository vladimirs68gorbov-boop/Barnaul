name: Build Barnaul APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'barnaul-bespredel-source.zip'
      - '.github/workflows/build-apk.yml'

permissions:
  contents: read

concurrency:
  group: barnaul-apk-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Compile Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Check out repository
        uses: actions/checkout@v6

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4

      - name: Install Android API 34 packages
        run: sdkmanager "platforms;android-34" "build-tools;34.0.0"

      - name: Set up Gradle 8.7
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: '8.7'

      - name: Unpack source project
        run: |
          test -f barnaul-bespredel-source.zip || {
            echo "Missing barnaul-bespredel-source.zip in repository root" >&2
            exit 1
          }
          mkdir -p "$RUNNER_TEMP/barnaul-source"
          unzip -q barnaul-bespredel-source.zip -d "$RUNNER_TEMP/barnaul-source"
          test -f "$RUNNER_TEMP/barnaul-source/barnaul-bespredel/settings.gradle.kts"

      - name: Build installable debug APK
        working-directory: ${{ runner.temp }}/barnaul-source/barnaul-bespredel
        run: gradle --no-daemon --stacktrace assembleDebug

      - name: Prepare APK artifact
        run: |
          mkdir -p output
          cp "$RUNNER_TEMP/barnaul-source/barnaul-bespredel/app/build/outputs/apk/debug/app-debug.apk" \
             output/Barnaul-Bespredel-debug.apk
          sha256sum output/Barnaul-Bespredel-debug.apk | tee output/SHA256SUMS.txt

      - name: Upload APK
        uses: actions/upload-artifact@v7
        with:
          name: Barnaul-Bespredel-debug-APK
          path: output/*
          if-no-files-found: error
          retention-days: 14
